{
  "name": "guston",
  "version": "0.1.0",
  "private": true,
  "description": "Dateibasiertes Second Brain: reindumpen, einordnen, wiederfinden — lokal, portabel, LLM-gestützt",
  "author": "Hantsch",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=20.19"
  },
  "build": {
    "appId": "app.hantsch.guston",
    "productName": "Guston",
    "artifactName": "guston-${version}-portable.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "unicode": true
    }
  },
  "scripts": {
    "dev": "node scripts/start.mjs dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --win portable",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed-vault.mjs",
    "shot": "node scripts/shot.mjs",
    "a11y": "node scripts/a11y.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:ui": "npm run seed && npm run build && npm run shot && npm run a11y"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@tanstack/react-query": "^5.101.2",
    "chokidar": "^5.0.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.9",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "turndown": "^7.2.4",
    "yaml": "^2.8.1",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}