{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": true,
    "noEmit": true,
    "paths": {
      "@core/*": ["./src/core/*"],
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "tests/renderer/**/*",
    "src/core/llm/capacity-bands.ts",
    "src/core/llm/sensitive.ts",
    "src/core/llm/tasks.ts",
    "src/core/llm/types.ts",
    "src/core/llm/catalogue/index.ts",
    "src/core/llm/catalogue/openrouter.ts",
    "src/core/llm/catalogue/models.json",
    "src/core/agent/help/version.ts",
    "src/core/agent/setup-templates.ts",
    "src/core/agent/setup-types.ts",
    "src/core/agent/templates/*.ts",
    "src/core/condense/diff.ts",
    "src/core/condense/paths.ts",
    "src/core/vault/paths.ts",
    "src/core/vault/slug.ts",
    "src/core/vault/types.ts",
    "src/core/wiki/log-heading.ts"
  ]
}
